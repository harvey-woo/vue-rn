{
  "name": "@cat5th/vue-rn",
  "version": "0.1.0",
  "description": "Vue 3 custom renderer for React Native Fabric",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.mjs",
      "require": "./dist/router.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.mjs",
      "require": "./dist/web/index.js"
    },
    "./metro": {
      "types": "./dist/metro/index.d.ts",
      "import": "./dist/metro/index.mjs",
      "require": "./dist/metro/index.js"
    },
    "./dist/transformer/*": "./dist/transformer/*",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "router": [
        "./dist/router.d.ts"
      ],
      "web": [
        "./dist/web/index.d.ts"
      ],
      "metro": [
        "./dist/metro/index.d.ts"
      ],
      "dist/index": [
        "./dist/index.d.ts"
      ],
      "dist/router": [
        "./dist/router.d.ts"
      ],
      "dist/web/*": [
        "./dist/web/*"
      ],
      "dist/transformer/*": [
        "./dist/transformer/*"
      ]
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.transformer.json",
    "build:transformer": "tsc -p tsconfig.transformer.json",
    "clean": "rm -rf dist",
    "sync-bench-rn": "node scripts/sync-bench-rn.js",
    "bench": "node scripts/bench.js"
  },
  "peerDependencies": {
    "@rasenjs/rn-dom": "^0.1.0 || ^0.2.0",
    "@vue/runtime-core": "^3.4.0",
    "vue": "^3.4.0",
    "vue-router": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-syntax-typescript": "^7.25.0",
    "@babel/plugin-transform-typescript": "^7.25.0",
    "@react-native/metro-babel-transformer": "0.86.0",
    "@types/node": "^20.10.0",
    "@vue/compiler-core": "^3.5.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/runtime-core": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "tags.d.ts"
  ]
}
